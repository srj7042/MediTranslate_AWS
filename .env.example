# Environment & General
ENVIRONMENT=dev
LOG_LEVEL=INFO
APP_NAME=MediTranslate
CREATOR_NAME=Suraj Jaiswal

# Supabase PostgreSQL Database (Backend only)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/meditranslate
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AWS Infrastructure Configuration
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
S3_UPLOAD_BUCKET=meditranslate-dev-uploads
S3_RESULT_BUCKET=meditranslate-dev-results
STEP_FUNCTION_ARN=arn:aws:states:us-east-1:123456789012:stateMachine:MediTranslateProcessingDev

# Amazon Cognito Authentication
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_xxxxxxxxx

# Amazon Bedrock & AI Models
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
BEDROCK_REGION=us-east-1

# Frontend Configuration (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_AWS_REGION=us-east-1
NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
NEXT_PUBLIC_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
